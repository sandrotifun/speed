-- ==================== AW ЛОГИКА ====================
local ctrl, prevCtrl = false, false
UIS.InputBegan:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.LeftControl or i.KeyCode == Enum.KeyCode.RightControl then
        ctrl = true
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.LeftControl or i.KeyCode == Enum.KeyCode.RightControl then
        ctrl = false
    end
end)

local function isInVehicle()
    local char = Players.LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return false end
    return hum.SeatPart:IsA("VehicleSeat") or hum.SeatPart:IsA("Seat")
end

local smoothPitch = 0
local function getPitch()
    local char = Players.LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return nil end
    local seat = hum.SeatPart
    if not seat:IsA("BasePart") then return nil end
    local raw = math.deg(math.asin(math.clamp(seat.CFrame.LookVector.Y, -1, 1)))
    smoothPitch = smoothPitch + (raw - smoothPitch) * AW.SMOOTH
    return smoothPitch
end

local wSent, sSent = false, false
local function sendW(d)
    if d == wSent then return end
    wSent = d
    VIM:SendKeyEvent(d, Enum.KeyCode.W, false, game)
end
local function sendS(d)
    if d == sSent then return end
    sSent = d
    VIM:SendKeyEvent(d, Enum.KeyCode.S, false, game)
end

local pIsDown = false
local function setP(down)
    if down == pIsDown then return end
    pIsDown = down
    VIM:SendKeyEvent(down, AW.PKey, false, game)
    P("P "..(down and "DOWN" or "UP"))
end

local prevPitch = 0
local wTimer, wLockout, lastLog = 0, 0, 0
local kickTimer, kickArmed = 0, false
local cruiseRelease = 0

RunService.Heartbeat:Connect(function(dt)
    if ctrl and not prevCtrl then
        kickArmed = true; kickTimer = 0; smoothPitch = 0
    end
    if not ctrl then
        kickArmed = false; kickTimer = 0; cruiseRelease = 0
    end
    prevCtrl = ctrl

    if not AW.Enabled or not ctrl or not isInVehicle() then
        sendW(false); sendS(false); setP(false)
        wTimer, wLockout = 0, 0
        return
    end

    local pitch = getPitch()
    if not pitch then sendW(false); sendS(false); setP(false) return end
    local speed = (pitch - prevPitch) / math.max(dt, 0.001)
    prevPitch = pitch

    if AW.PEnabled then
        local lo, hi = math.min(AW.PFrom, AW.PTo), math.max(AW.PFrom, AW.PTo)
        setP(pitch >= lo and pitch <= hi)
    else
        setP(false)
    end

    if pitch >= AW.OVER then
        sendW(false); sendS(true)
        wTimer, wLockout, kickTimer, kickArmed = 0, 0.15, 0, false
        cruiseRelease = 0.25
        return
    end

    sendS(false)

    if kickArmed then
        if kickTimer <= 0 then kickTimer = AW.KICK_TIME end
        kickTimer = kickTimer - dt
        sendW(true)
        if kickTimer <= 0 or pitch >= AW.TARGET then
            kickArmed = false
            wLockout = 0.10
        end
        return
    end

    if AW.Cruise then
        if cruiseRelease > 0 then
            cruiseRelease = cruiseRelease - dt
            sendW(false)
            return
        end
        if pitch > AW.TARGET then
            sendW(false); cruiseRelease = 0.08
        else
            sendW(true)
        end
        return
    end

    if wTimer > 0 then wTimer = wTimer - dt end
    if wLockout > 0 then wLockout = wLockout - dt end

    if wTimer > 0 then
        sendW(true)
    else
        sendW(false)
        if wLockout <= 0 and pitch < AW.TARGET and speed < AW.RISE_SPD then
            local err  = AW.TARGET - pitch
            local fall = math.max(0, -speed)
            local duty = math.clamp(err/20 + fall/30, 0, 1)
            wTimer   = AW.PULSE_MIN + (AW.PULSE_MAX - AW.PULSE_MIN) * duty
            wLockout = 0.25
        end
    end
end)

