-- ==================== LIGHTING / FX ====================
local FX_NAMES = { ColorCorrection="SH_ColorCorrection", Bloom="SH_Bloom", SunRays="SH_SunRays", Blur="SH_Blur", Atmosphere="SH_Atmosphere" }
local FX_CLASSES = { ColorCorrection="ColorCorrectionEffect", Bloom="BloomEffect", SunRays="SunRaysEffect", Blur="BlurEffect", Atmosphere="Atmosphere" }

local function ensureEffect(key)
    local name = FX_NAMES[key]; local class = FX_CLASSES[key]
    local fx = Lighting:FindFirstChild(name)
    if not fx or not fx:IsA(class) then
        if fx then fx:Destroy() end
        local ok, newFx = pcall(Instance.new, class)
        if not ok then return nil end
        fx = newFx; fx.Name = name; fx.Parent = Lighting
    end
    return fx
end

local function setEffect(key, props)
    local hasAny = false
    for _, v in pairs(props) do if v ~= nil then hasAny = true break end end
    if not hasAny then
        local fx = Lighting:FindFirstChild(FX_NAMES[key])
        if fx then fx:Destroy() end
        return
    end
    local fx = ensureEffect(key)
    if not fx then return end
    for k, v in pairs(props) do if v ~= nil then pcall(function() fx[k] = v end) end end
end

local function resetEffects()
    for _, name in pairs(FX_NAMES) do
        local fx = Lighting:FindFirstChild(name)
        if fx then fx:Destroy() end
    end
end

local function applyCC() setEffect("ColorCorrection", { Brightness=CC.Brightness~=0 and CC.Brightness or nil, Contrast=CC.Contrast~=0 and CC.Contrast or nil, Saturation=CC.Saturation~=0 and CC.Saturation or nil, TintColor=CC.TintColor }) end
local function applyBL() setEffect("Bloom", { Intensity=BL.Intensity, Size=BL.Size, Threshold=BL.Threshold }) end
local function applySR() setEffect("SunRays", { Intensity=SR.Intensity, Spread=SR.Spread }) end
local function applyBR() setEffect("Blur", { Size=BR.Size }) end
local function applyAT() setEffect("Atmosphere", { Density=AT.Density, Haze=AT.Haze, Glare=AT.Glare, Color=AT.Color }) end

local function resetLighting()
    TimeLock.Active = false
    for k, v in pairs(LightOrig) do
        pcall(function() Lighting[k] = v end)
    end
end
