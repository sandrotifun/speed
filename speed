-- ==================== CONFIG SYSTEM ====================
local CONFIG_FOLDER = "SashamotyanHub_Configs"
if not isfolder(CONFIG_FOLDER) then
    makefolder(CONFIG_FOLDER)
end

local Elements = {}   -- ссылки на элементы UI для обновления

local function keyByName(name)
    for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
        if k.Name == name then return k end
    end
    return Enum.KeyCode.LeftAlt
end

local function buildConfig()
    return {
        VehicleSpeed = VehicleSpeed,
        BoostKeybind = BoostKeybind.Name,
        AW = {
            Enabled   = AW.Enabled,
            TARGET    = AW.TARGET,
            FALL_SPD  = AW.FALL_SPD,
            RISE_SPD  = AW.RISE_SPD,
            PULSE_MIN = AW.PULSE_MIN,
            PULSE_MAX = AW.PULSE_MAX,
            SMOOTH    = AW.SMOOTH,
            OVER      = AW.OVER,
            KICK_TIME = AW.KICK_TIME,
            Cruise    = AW.Cruise,
            PEnabled  = AW.PEnabled,
            PFrom     = AW.PFrom,
            PTo       = AW.PTo,
        }
    }
end

local function applyConfig(cfg)
    if cfg.VehicleSpeed then VehicleSpeed = cfg.VehicleSpeed end
    if cfg.BoostKeybind then BoostKeybind = keyByName(cfg.BoostKeybind) end
    if cfg.AW then
        for k, v in pairs(cfg.AW) do
            AW[k] = v
        end
    end
    -- Обновляем UI
    if Elements.Speed     then Elements.Speed:Set(VehicleSpeed) end
    if Elements.Enabled   then Elements.Enabled:Set(AW.Enabled) end
    if Elements.Cruise    then Elements.Cruise:Set(AW.Cruise) end
    if Elements.Target    then Elements.Target:Set(AW.TARGET) end
    if Elements.Over      then Elements.Over:Set(AW.OVER) end
    if Elements.Kick      then Elements.Kick:Set(AW.KICK_TIME) end
    if Elements.PEnabled  then Elements.PEnabled:Set(AW.PEnabled) end
    if Elements.PFrom     then Elements.PFrom:Set(AW.PFrom) end
    if Elements.PTo       then Elements.PTo:Set(AW.PTo) end
    if Elements.FallSpd   then Elements.FallSpd:Set(AW.FALL_SPD) end
    if Elements.RiseSpd   then Elements.RiseSpd:Set(AW.RISE_SPD) end
    if Elements.PulseMin  then Elements.PulseMin:Set(AW.PULSE_MIN) end
    if Elements.PulseMax  then Elements.PulseMax:Set(AW.PULSE_MAX) end
    if Elements.Smooth    then Elements.Smooth:Set(AW.SMOOTH) end
    if Elements.Logs      then Elements.Logs:Set(AW.LOGS) end
end

local function saveConfig(name)
    if not name or name == "" then return false, "Пустое имя" end
    local ok, encoded = pcall(function() return game:GetService("HttpService"):JSONEncode(buildConfig()) end)
    if not ok then return false, "Ошибка кодирования" end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    local sok, serr = pcall(function() writefile(path, encoded) end)
    if not sok then return false, "Ошибка записи: " .. tostring(serr) end
    return true
end

local function loadConfig(name)
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false, "Файл не найден" end
    local ok, data = pcall(function() return readfile(path) end)
    if not ok then return false, "Ошибка чтения" end
    local dok, cfg = pcall(function() return game:GetService("HttpService"):JSONDecode(data) end)
    if not dok then return false, "Ошибка парсинга" end
    applyConfig(cfg)
    return true
end

local function deleteConfig(name)
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    pcall(function() delfile(path) end)
    return true
end

local function listConfigs()
    local out = {}
    local ok, files = pcall(function() return listfiles(CONFIG_FOLDER) end)
    if not ok or not files then return out end
    for _, path in ipairs(files) do
        local name = path:match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    return out
end

-- ==================== SPEED HACK ФУНКЦИИ ====================
local function GetVehicle()
    local Seat = Humanoid.SeatPart
    if Seat and Seat:IsA("VehicleSeat") then return Seat.Parent end
end

local function BoostForward()
    local Vehicle = GetVehicle()
    if Vehicle and Vehicle.PrimaryPart then
        Vehicle.PrimaryPart.AssemblyLinearVelocity =
            Vehicle.PrimaryPart.CFrame.LookVector * VehicleSpeed * 5
    elseif Vehicle then
        local Base = Vehicle:FindFirstChild("Chassis")
            or Vehicle:FindFirstChild("Body")
            or Vehicle:FindFirstChildWhichIsA("BasePart")
        if Base then
            Base.AssemblyLinearVelocity = Base.CFrame.LookVector * VehicleSpeed * 5
        end
    else
        Rayfield:Notify({Title="Ошибка", Content="Ты не в машине!", Duration=3})
    end
end

