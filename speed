-- ==================== AUTO NOHAND v4 ====================
local nhRecoverStart = 0
local nhZCooldown    = 0
local nhLastLog      = 0
local nhWSent        = false

local function PN2(...) if NH.Logs then print("[NH]", ...) end end

-- Отправка Z с cooldown
local function nhPressZ()
    if tick() < nhZCooldown then return end
    nhZCooldown = tick() + 0.35
    task.spawn(function()
        VIM:SendKeyEvent(true,  NH.ZKey, false, game)
        task.wait(0.10)
        VIM:SendKeyEvent(false, NH.ZKey, false, game)
    end)
    PN2("Z pressed")
end

-- W с отслеживанием (без спама)
local function nhSetW(on)
    if on == nhWSent then return end
    nhWSent = on
    VIM:SendKeyEvent(on, Enum.KeyCode.W, false, game)
end

-- Старт режима
local function nhStart()
    if NH.State ~= "LOCKED" then return end
    NH.State = "BALANCE"
    nhPressZ()       -- убираем руки
    PN2("START → hands off")
end

-- Стоп режима
local function nhStop()
    if NH.State == "LOCKED" then return end
    nhSetW(false)
    if NH.State == "BALANCE" then
        nhPressZ()   -- возвращаем руки (они были убраны)
    end
    NH.State = "LOCKED"
    PN2("STOP → hands returned")
end

-- Тик
local function nohandTick(dt)
    if NH.State == "LOCKED" then return end
    if not isInVehicle() then nhStop() return end

    local pitch = getPitch(0.5)
    if not pitch then return end

    if NH.Logs and tick() - nhLastLog > 0.4 then
        nhLastLog = tick()
        PN2(string.format("state=%s  pitch=%.1f  W=%s",
            NH.State, pitch, tostring(nhWSent)))
    end

    if NH.State == "BALANCE" then
        -- Руки убраны, ждём просадки
        if pitch < NH.RecoverThreshold then
            nhPressZ()                 -- берём руль
            NH.State = "RECOVER"
            nhRecoverStart = tick()
            PN2("balance lost → grab wheel")
        end
    elseif NH.State == "RECOVER" then
        local elapsed = tick() - nhRecoverStart

        -- Восстановились
        if pitch >= NH.ReturnThreshold then
            nhSetW(false)
            nhPressZ()                 -- убираем руки
            NH.State = "BALANCE"
            PN2("balance ok → release hands")
            return
        end

        -- Аварийный таймаут (если восстанавливаемся слишком долго)
        if elapsed > NH.MaxRecoverTime then
            nhSetW(false)
            nhPressZ()                 -- убираем руки
            NH.State = "BALANCE"
            PN2("recover timeout → release hands")
            return
        end

        -- Газуем
        nhSetW(true)
    end
end
