local function GetVehicle()
    local Seat = Humanoid.SeatPart
    if Seat and Seat:IsA("VehicleSeat") then return Seat.Parent end
end

local function BoostForward()
    local Vehicle = GetVehicle()
    if Vehicle and Vehicle.PrimaryPart then
        Vehicle.PrimaryPart.AssemblyLinearVelocity =
            Vehicle.PrimaryPart.CFrame.LookVector * VehicleSpeed * 5
    elseif Vehicle then
        local Base = Vehicle:FindFirstChild("Chassis") or Vehicle:FindFirstChild("Body")
            or Vehicle:FindFirstChildWhichIsA("BasePart")
        if Base then
            Base.AssemblyLinearVelocity = Base.CFrame.LookVector * VehicleSpeed * 5
        end
    end
end

local function isInVehicleSafe()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return false end
    return hum.SeatPart:IsA("VehicleSeat") or hum.SeatPart:IsA("Seat")
end

local smoothPitch = 0
local function getPitch()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return nil end
    local seat = hum.SeatPart
    if not seat:IsA("BasePart") then return nil end
    local raw = math.deg(math.asin(math.clamp(seat.CFrame.LookVector.Y, -1, 1)))
    smoothPitch = smoothPitch + (raw - smoothPitch) * safeNum(AW.SMOOTH, 0.5)
    return smoothPitch
end

