local function applyMainConfig(cfg)
    if type(cfg) ~= "table" then return end
    if cfg.VehicleSpeed then VehicleSpeed = safeNum(cfg.VehicleSpeed, 50) end
    if cfg.AW then for k, v in pairs(cfg.AW) do AW[k] = v end end
    if cfg.BoostKeybind then
        local keyName = cfg.BoostKeybind
        for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
            if k.Name == keyName then
                BoostKeybind = k
                BoostBindState.value = k
                break
            end
        end
    end
    if cfg.Theme and ThemeColors[cfg.Theme] then
        currentTheme = cfg.Theme
        saveThemeToFile(cfg.Theme)
        pcall(function() Fluent:SetTheme(cfg.Theme) end)
        task.wait(0.05)
        applyHUDColors()
    end
end

local function applyVisualConfig(cfg)
    if type(cfg) ~= "table" then return end

    if cfg.HUD then
        for k, v in pairs(cfg.HUD) do
            if k == "Accent" and type(v) == "table" then HUD.Accent = Color3.new(unpack(v))
            elseif k == "BgColor" and type(v) == "table" then HUD.BgColor = Color3.new(unpack(v))
            else HUD[k] = v end
        end
        if hudFrame then hudFrame.Position = UDim2.new(0, HUD.X, 0, HUD.Y) end
        if hudShadow then hudShadow.Position = UDim2.new(0, HUD.X + 120, 0, HUD.Y + 72) end
        if hudLabel then hudLabel.TextSize = HUD.Size end
        if hudFrame then hudFrame.Visible = HUD.Enabled end
        if hudShadow then hudShadow.Visible = HUD.Enabled end
        applyHUDColors()
    end

    if cfg.Trail then
        TrailCfg.Enabled = cfg.Trail.Enabled or false
        TrailCfg.Lifetime = safeNum(cfg.Trail.Lifetime, 0.6)
        TrailCfg.Transparency = safeNum(cfg.Trail.Transparency, 0.2)
        TrailCfg.Brightness = safeNum(cfg.Trail.Brightness, 0.6)
        TrailCfg.OffsetX = safeNum(cfg.Trail.OffsetX, 0)
        TrailCfg.OffsetY = safeNum(cfg.Trail.OffsetY, 0)
        TrailCfg.OffsetZ = safeNum(cfg.Trail.OffsetZ, 0)
        TrailCfg.Mode = cfg.Trail.Mode or "auto"
        TrailCfg.ManualPath = cfg.Trail.ManualPath or ""
        TrailCfg.FlatHeight = safeNum(cfg.Trail.FlatHeight, 0.05)
        TrailCfg.FlatWidth = safeNum(cfg.Trail.FlatWidth, 1.5)
        TrailCfg.FlatRotation = safeNum(cfg.Trail.FlatRotation, 0)
        TrailCfg.FlatOffsetX = safeNum(cfg.Trail.FlatOffsetX, 0)
        TrailCfg.FlatOffsetZ = safeNum(cfg.Trail.FlatOffsetZ, 0)
        if cfg.Trail.Color1 then TrailCfg.Color1 = Color3.new(unpack(cfg.Trail.Color1)) end
        if cfg.Trail.Color2 then TrailCfg.Color2 = Color3.new(unpack(cfg.Trail.Color2)) end
        destroyTrail(); destroyFlatTrail()
        if TrailCfg.Enabled then
            if TrailCfg.Mode == "flat" then rebuildFlatTrail() else rebuildTrail() end
        end
    end

    if cfg.Lighting then
        local L = cfg.Lighting
        if L.Brightness then Lighting.Brightness = safeNum(L.Brightness, 1) end
        if L.ClockTime then Lighting.ClockTime = safeNum(L.ClockTime, 14) end
        if L.ExposureCompensation then Lighting.ExposureCompensation = safeNum(L.ExposureCompensation, 0) end
        if L.GlobalShadows ~= nil then Lighting.GlobalShadows = L.GlobalShadows end
        if type(L.Ambient) == "table" then Lighting.Ambient = Color3.new(unpack(L.Ambient)) end
        if type(L.OutdoorAmbient) == "table" then Lighting.OutdoorAmbient = Color3.new(unpack(L.OutdoorAmbient)) end
        if L.EnvironmentDiffuseScale then Lighting.EnvironmentDiffuseScale = safeNum(L.EnvironmentDiffuseScale, 0) end
        if L.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = safeNum(L.EnvironmentSpecularScale, 0) end
        if L.TimeLockActive ~= nil then TimeLock.Active = L.TimeLockActive end
        if L.TimeLockValue then TimeLock.Value = safeNum(L.TimeLockValue, 14) end
    end

    if cfg.CC then
        CC.Brightness = safeNum(cfg.CC.Brightness, 0)
        CC.Contrast = safeNum(cfg.CC.Contrast, 0)
        CC.Saturation = safeNum(cfg.CC.Saturation, 0)
        if cfg.CC.TintColor then CC.TintColor = Color3.new(unpack(cfg.CC.TintColor)) end
        pcall(applyCC)
    end
    if cfg.BL then
        BL.Intensity = cfg.BL.Intensity; BL.Size = cfg.BL.Size; BL.Threshold = cfg.BL.Threshold
        pcall(applyBL)
    end
    if cfg.SR then SR.Intensity = cfg.SR.Intensity; SR.Spread = cfg.SR.Spread; pcall(applySR) end
    if cfg.BR then BR.Size = cfg.BR.Size; pcall(applyBR) end
    if cfg.AT then
        AT.Density = cfg.AT.Density; AT.Haze = cfg.AT.Haze; AT.Glare = cfg.AT.Glare
        if cfg.AT.Color then AT.Color = Color3.new(unpack(cfg.AT.Color)) end
        pcall(applyAT)
    end
end

