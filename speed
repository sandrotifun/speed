local trailInst, trailAttach1, trailAttach2, trailHostPart
local flatPart, flatAttach1, flatAttach2, flatTrail

local function findRearPart(car)
    local seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return nil end
    local seatPos = seat.Position
    local backDir = -seat.CFrame.LookVector
    local best, bestDot = nil, -math.huge
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") and d ~= seat and not d.Massless then
            local dot = (d.Position - seatPos):Dot(backDir)
            if dot > bestDot then bestDot = dot; best = d end
        end
    end
    return best
end

local function findPartByPath(path)
    if not path or path == "" then return nil end
    path = path:gsub("^Workspace%.", ""):gsub("^workspace%.", "")
    local node = workspace
    for seg in string.gmatch(path, "[^%.]+") do
        node = node:FindFirstChild(seg)
        if not node then return nil end
    end
    return node
end

local function getCarParts()
    local out = {}
    local char = LocalPlayer.Character
    if not char then return out end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return out end
    local car = hum.SeatPart.Parent
    if not car then return out end
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then
            local cleanName = (d:GetFullName():gsub("^Workspace%.", ""))
            table.insert(out, cleanName)
        end
    end
    return out
end

local function destroyTrail()
    if trailInst then trailInst:Destroy() trailInst = nil end
    if trailAttach1 then trailAttach1:Destroy() trailAttach1 = nil end
    if trailAttach2 then trailAttach2:Destroy() trailAttach2 = nil end
    trailHostPart = nil
end

local function destroyFlatTrail()
    if flatTrail then flatTrail:Destroy() flatTrail = nil end
    if flatAttach1 then flatAttach1:Destroy() flatAttach1 = nil end
    if flatAttach2 then flatAttach2:Destroy() flatAttach2 = nil end
    if flatPart then flatPart:Destroy() flatPart = nil end
end

local function updateTrailProps()
    local inst = trailInst or flatTrail
    if not inst then return end
    pcall(function()
        inst.Lifetime = TrailCfg.Lifetime
        inst.Color = ColorSequence.new(TrailCfg.Color1, TrailCfg.Color2)
        inst.Transparency = NumberSequence.new(safeNum(TrailCfg.Transparency, 0.2))
        inst.LightEmission = math.clamp(safeNum(TrailCfg.Brightness, 0.6), 0, 1)
        inst.LightInfluence = 1 - math.clamp(safeNum(TrailCfg.Brightness, 0.6), 0, 1)
    end)
    if trailAttach1 then
        trailAttach1.Position = Vector3.new(TrailCfg.OffsetX, TrailCfg.OffsetY + 0.2, TrailCfg.OffsetZ)
    end
    if trailAttach2 then
        trailAttach2.Position = Vector3.new(TrailCfg.OffsetX, TrailCfg.OffsetY - 0.2, TrailCfg.OffsetZ)
    end
    if flatAttach1 then flatAttach1.Position = Vector3.new(TrailCfg.FlatWidth/2, 0, 0) end
    if flatAttach2 then flatAttach2.Position = Vector3.new(-TrailCfg.FlatWidth/2, 0, 0) end
end

local function rebuildTrail()
    destroyTrail()
    if not TrailCfg.Enabled or TrailCfg.Mode == "flat" then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return end
    local car = hum.SeatPart.Parent
    if not car then return end
    local target
    if TrailCfg.Mode == "manual" and TrailCfg.ManualPath ~= "" then
        target = findPartByPath(TrailCfg.ManualPath)
    end
    if not target or not target:IsA("BasePart") then
        target = findRearPart(car)
    end
    if not target then return end
    trailHostPart = target
    trailAttach1 = Instance.new("Attachment")
    trailAttach1.Parent = target
    trailAttach2 = Instance.new("Attachment")
    trailAttach2.Parent = target
    trailInst = Instance.new("Trail")
    trailInst.Attachment0 = trailAttach1
    trailInst.Attachment1 = trailAttach2
    trailInst.FaceCamera = true
    trailInst.Parent = target
    updateTrailProps()
end

local function rebuildFlatTrail()
    destroyFlatTrail()
    if not TrailCfg.Enabled or TrailCfg.Mode ~= "flat" then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return end
    local car = hum.SeatPart.Parent
    if not car then return end
    local target
    if TrailCfg.ManualPath ~= "" then target = findPartByPath(TrailCfg.ManualPath) end
    if not target or not target:IsA("BasePart") then target = findRearPart(car) end
    if not target then return end
    flatPart = Instance.new("Part")
    flatPart.Name = "SH_FlatTrailPart"
    flatPart.Anchored = true
    flatPart.CanCollide = false
    flatPart.CanQuery = false
    flatPart.CanTouch = false
    flatPart.Transparency = 1
    flatPart.Size = Vector3.new(0.1, 0.1, 0.1)
    flatPart.CFrame = target.CFrame
    flatPart.Parent = workspace
    flatAttach1 = Instance.new("Attachment")
    flatAttach1.Parent = flatPart
    flatAttach2 = Instance.new("Attachment")
    flatAttach2.Parent = flatPart
    flatTrail = Instance.new("Trail")
    flatTrail.Attachment0 = flatAttach1
    flatTrail.Attachment1 = flatAttach2
    flatTrail.FaceCamera = false
    flatTrail.Parent = flatPart
    updateTrailProps()
end

local function updateFlatTrailPosition()
    if not flatPart or not flatPart.Parent then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return end
    local car = hum.SeatPart.Parent
    if not car then return end
    local target
    if TrailCfg.ManualPath ~= "" then target = findPartByPath(TrailCfg.ManualPath) end
    if not target or not target:IsA("BasePart") then target = findRearPart(car) end
    if not target then return end

    local pos = target.Position
    local look = target.CFrame.LookVector
    local right = target.CFrame.RightVector

    local offX = safeNum(TrailCfg.FlatOffsetX, 0)
    local offZ = safeNum(TrailCfg.FlatOffsetZ, 0)
    local flatLookUnit = Vector3.new(look.X, 0, look.Z)
    if flatLookUnit.Magnitude < 0.01 then flatLookUnit = Vector3.new(1, 0, 0) end
    flatLookUnit = flatLookUnit.Unit
    local offset = right * offX + flatLookUnit * offZ

    local groundY = pos.Y - (target.Size.Y / 2)
    local flatPos = Vector3.new(
        pos.X + offset.X,
        groundY + safeNum(TrailCfg.FlatHeight, 0.05),
        pos.Z + offset.Z
    )
    local cf = CFrame.lookAt(flatPos, flatPos + flatLookUnit)
    local rotDeg = math.floor(safeNum(TrailCfg.FlatRotation, 0) + 0.5)
    cf = cf * CFrame.Angles(0, math.rad(rotDeg), 0)
    flatPart.CFrame = cf
end

