local function P(...) if AW.LOGS then print("[AutoGas]", ...) end end

-- ==================== SPEED HACK ФУНКЦИИ ====================
local function GetVehicle()
    local Seat = Humanoid.SeatPart
    if Seat and Seat:IsA("VehicleSeat") then return Seat.Parent end
end

local function BoostForward()
    local Vehicle = GetVehicle()
    if Vehicle and Vehicle.PrimaryPart then
        Vehicle.PrimaryPart.AssemblyLinearVelocity =
            Vehicle.PrimaryPart.CFrame.LookVector * VehicleSpeed * 5
    elseif Vehicle then
        local Base = Vehicle:FindFirstChild("Chassis")
            or Vehicle:FindFirstChild("Body")
            or Vehicle:FindFirstChildWhichIsA("BasePart")
        if Base then
            Base.AssemblyLinearVelocity = Base.CFrame.LookVector * VehicleSpeed * 5
        end
    else
        Rayfield:Notify({Title="Ошибка", Content="Ты не в машине!", Duration=3})
    end
end

