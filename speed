local function listFiles(folder)
    local out = {}
    local ok, files = pcall(listfiles, folder)
    if not ok or not files then return { "—" } end
    for _, path in ipairs(files) do
        local name = path:match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    if #out == 0 then return { "—" } end
    return out
end

local function buildMainConfig()
    return {
        VehicleSpeed = VehicleSpeed, BoostKeybind = BoostBindState.value.Name,
        Theme = currentTheme,
        AW = {
            Enabled=AW.Enabled, TARGET=AW.TARGET, FALL_SPD=AW.FALL_SPD, RISE_SPD=AW.RISE_SPD,
            PULSE_MIN=AW.PULSE_MIN, PULSE_MAX=AW.PULSE_MAX, SMOOTH=AW.SMOOTH, OVER=AW.OVER,
            KICK_TIME=AW.KICK_TIME, Cruise=AW.Cruise, PEnabled=AW.PEnabled,
            PFrom=AW.PFrom, PTo=AW.PTo,
        },
    }
end

local function buildVisualConfig()
    return {
        HUD = {
            Enabled=HUD.Enabled, Size=HUD.Size, X=HUD.X, Y=HUD.Y, ShowSpeed=HUD.ShowSpeed,
            SpeedUnit=HUD.SpeedUnit,
