-- ==================== ГЛАВНЫЙ ЦИКЛ ====================
local prevPitch = 0
local wTimer, wLockout = 0, 0
local kickTimer, kickArmed = 0, false
local cruiseRelease = 0

local function pressZShort()
    task.spawn(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
        task.wait(0.08)
        VIM:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
    end)
end

RunService.Heartbeat:Connect(function(dt)
    if TimeLock.Active then
        local want = roundInt(TimeLock.Value)
        if math.abs(safeNum(Lighting.ClockTime, 0) - want) > 0.3 then
            pcall(function() Lighting.ClockTime = want end)
        end
    end

    if flatPart and flatPart.Parent then pcall(updateFlatTrailPosition) end

    -- HUD
    if HUD.Enabled and hudFrame and hudLabel then
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        local pitch, speedMps = 0, 0
        if seat and seat:IsA("BasePart") then
            pitch = math.deg(math.asin(math.clamp(seat.CFrame.LookVector.Y, -1, 1)))
            local vel = seat.AssemblyLinearVelocity
            speedMps = math.floor(math.sqrt(vel.X^2 + vel.Z^2) + 0.5)
        end
        local lines = {}
        local speedDisp = convertSpeed(speedMps)
        local speedLabel = speedUnitLabel()
        if Lang.current == "ru" then
            table.insert(lines, string.format("Угол: %6.1f°", pitch))
            if HUD.ShowSpeed then table.insert(lines, string.format("Скорость: %d %s", speedDisp, speedLabel)) end
            table.insert(lines, "Состояние: "..(AW.State or "IDLE"))
            local cs = ctrl and "ON" or (ctrlVirt and "VIRT" or "off")
            table.insert(lines, "Ctrl: "..cs.."  AW: "..(AW.Enabled and "ON" or "off"))
            if AutoTune.Running then table.insert(lines, string.format("Автотюн: %.1f/%d", tick()-AutoTune.StartTime, AutoTune.Duration)) end
            if ML.Running then table.insert(lines, "ML: "..#ML.Samples) end
            if Replay.Recording then table.insert(lines, "REC: "..#Replay.Buffer) end
            if Replay.Playing then table.insert(lines, "REPLAY") end
        else
            table.insert(lines, string.format("Angle: %6.1f°", pitch))
            if HUD.ShowSpeed then table.insert(lines, string.format("Speed: %d %s", speedDisp, speedLabel)) end
            table.insert(lines, "State: "..(AW.State or "IDLE"))
            local cs = ctrl and "ON" or (ctrlVirt and "VIRT" or "off")
            table.insert(lines, "Ctrl: "..cs.."  AW: "..(AW.Enabled and "ON" or "off"))
            if AutoTune.Running then table.insert(lines, string.format("Autotune: %.1f/%d", tick()-AutoTune.StartTime, AutoTune.Duration)) end
            if ML.Running then table.insert(lines, "ML: "..#ML.Samples) end
            if Replay.Recording then table.insert(lines, "REC: "..#Replay.Buffer) end
            if Replay.Playing then table.insert(lines, "REPLAY") end
        end
        hudLabel.Text = table.concat(lines, "\n")
    end

    -- AutoTune
    if AutoTune.Running then
        if not isInVehicleSafe() then
            AutoTune.Running = false
        else
            local pitch = getPitch()
            if pitch then table.insert(AutoTune.Samples, { t=tick(), pitch=safeNum(pitch, 0) }) end
            if tick() - AutoTune.StartTime >= safeNum(AutoTune.Duration, 30) then
                AutoTune.Running = false
                local arr = {}
                for _, s in ipairs(AutoTune.Samples) do table.insert(arr, safeNum(s.pitch, 0)) end
                table.sort(arr)
                if #arr > 10 then
                    local idxTop = math.max(1, math.floor(#arr * 0.95))
                    local idxMid = math.max(1, math.floor(#arr * 0.7))
                    AutoTune.Result = {
                        target = safeNum(arr[idxMid], 32),
                        over = math.min(160, safeNum(arr[idxTop], 45) * 1.05),
                        pulseMax = 0.22,
                        kickTime = math.min(1, safeNum(arr[idxMid], 32) / 80),
                    }
                    Fluent:Notify({ Title = "Автотюнинг", Content = "Готово! Нажми Применить", Duration = 4 })
                end
            end
        end
    end

    -- ML
    if ML.Running and isInVehicleSafe() then
        local pitch = getPitch()
        if pitch then table.insert(ML.Samples, { pitch = safeNum(pitch, 0) }) end
    end

    -- Replay запись
    if Replay.Recording then
        local now = tick() - Replay.StartTime
        local physKeys = {}
        local ok = pcall(function()
            for _, k in ipairs(UIS:GetKeysPressed()) do
                physKeys[k.KeyCode] = true
            end
        end)
        local function isPhys(kc)
            if ok then return physKeys[kc] == true end
            return UIS:IsKeyDown(kc)
        end
        local recW = isPhys(Enum.KeyCode.W) or (Replay.RecordAW and wSent)
        local recS = isPhys(Enum.KeyCode.S) or (Replay.RecordAW and sSent)
        local recA = isPhys(Enum.KeyCode.A)
        local recD = isPhys(Enum.KeyCode.D)
        local recQ = isPhys(Enum.KeyCode.Q)
        local recE = isPhys(Enum.KeyCode.E)
        local recC = isPhys(Enum.KeyCode.LeftControl) or isPhys(Enum.KeyCode.RightControl)

        while #zTapQueue > 0 do
            local tTap = table.remove(zTapQueue, 1)
            local tapOffset = tTap - Replay.StartTime
            if tapOffset >= 0 then
                table.insert(Replay.Buffer, {
                    t = math.floor(tapOffset * 1000),
                    zt = 1,
                    w = 0, s = 0, a = 0, d = 0, q = 0, e = 0, c = 0,
                })
            end
        end

        local changed = recW ~= Replay.LastW or recS ~= Replay.LastS
            or recA ~= Replay.LastA or recD ~= Replay.LastD
            or recQ ~= Replay.LastQ or recE ~= Replay.LastE
            or recC ~= Replay.LastCtrl

        if changed and (now - safeNum(Replay.LastRecTime, 0) >= 0.05) then
            Replay.LastRecTime = now
            Replay.LastW, Replay.LastS = recW, recS
            Replay.LastA, Replay.LastD = recA, recD
            Replay.LastQ, Replay.LastE = recQ, recE
            Replay.LastCtrl = recC
            table.insert(Replay.Buffer, {
                t = math.floor(now * 1000),
                w = recW and 1 or 0, s = recS and 1 or 0,
                a = recA and 1 or 0, d = recD and 1 or 0,
                q = recQ and 1 or 0, e = recE and 1 or 0,
                c = recC and 1 or 0,
                zt = 0,
            })
        end
    end

    -- Replay воспроизведение
    if Replay.Playing then
        local now = (tick() - Replay.PlayStartTime) * 1000
        local buf = Replay.Buffer
        local idx = Replay._playIdx or 1
        while idx <= #buf and safeNum(buf[idx].t, 0) <= now do
            local e = buf[idx]
            if (e.zt or 0) == 1 then
                pressZShort()
            else
                sendW(e.w == 1); sendS(e.s == 1)
                sendA((e.a or 0) == 1); sendD((e.d or 0) == 1)
                sendQ((e.q or 0) == 1); sendE((e.e or 0) == 1)
                sendCtrl((e.c or 0) == 1)
            end
            idx = idx + 1
        end
        Replay._playIdx = idx
        if idx > #buf then
            Replay.Playing = false
            sendW(false); sendS(false); sendA(false); sendD(false)
            sendQ(false); sendE(false); sendCtrl(false); setP(false)
            Fluent:Notify({ Title = "Реплей", Content = "Конец", Duration = 2 })
        end
        return
    end

    -- Trail авто-привязка
    if TrailCfg.Enabled and TrailCfg.Mode ~= "flat" then
        if not trailInst then pcall(rebuildTrail) end
        if trailInst and trailHostPart and not trailHostPart.Parent then pcall(rebuildTrail) end
    end
    if TrailCfg.Enabled and TrailCfg.Mode == "flat" and not flatPart then
        pcall(rebuildFlatTrail)
    end

    -- AW логика
    if ctrl and not prevCtrl then
        kickArmed = true; kickTimer = 0; smoothPitch = 0
    end
    if not ctrl then
        kickArmed = false; kickTimer = 0; cruiseRelease = 0
    end
    prevCtrl = ctrl

    if not AW.Enabled or not ctrl or not isInVehicleSafe() then
        sendW(false); sendS(false); setP(false)
        wTimer, wLockout = 0, 0
        AW.State = "IDLE"
        return
    end

    local pitch = getPitch()
    if not pitch then sendW(false); sendS(false); setP(false) return end
    local speed = (safeNum(pitch,0) - safeNum(prevPitch,0)) / math.max(safeNum(dt, 0.001), 0.001)
    prevPitch = pitch

    if AW.PEnabled then
        local lo, hi = math.min(safeNum(AW.PFrom,82), safeNum(AW.PTo,180)),
                       math.max(safeNum(AW.PFrom,82), safeNum(AW.PTo,180))
        setP(pitch >= lo and pitch <= hi)
    else
        setP(false)
    end

    if pitch >= safeNum(AW.OVER, 45) then
        sendW(false); sendS(true)
        wTimer, wLockout, kickTimer, kickArmed = 0, 0.15, 0, false
        cruiseRelease = 0.25
        AW.State = "OVER"
        return
    end

    sendS(false)

    if kickArmed then
        AW.State = "KICK"
        if kickTimer <= 0 then kickTimer = safeNum(AW.KICK_TIME, 0.3) end
        kickTimer = kickTimer - safeNum(dt, 0.016)
        sendW(true)
        if kickTimer <= 0 or pitch >= safeNum(AW.TARGET, 32) then
            kickArmed = false
            wLockout = 0.10
        end
        return
    end

    if AW.Cruise then
        AW.State = "CRUISE"
        if cruiseRelease > 0 then
            cruiseRelease = cruiseRelease - safeNum(dt, 0.016)
            sendW(false)
            return
        end
        if pitch > safeNum(AW.TARGET, 32) then
            sendW(false); cruiseRelease = 0.08
        else
            sendW(true)
        end
        return
    end

    AW.State = "HOLD"
    if wTimer > 0 then wTimer = wTimer - safeNum(dt, 0.016) end
    if wLockout > 0 then wLockout = wLockout - safeNum(dt, 0.016) end

    if wTimer > 0 then
        sendW(true)
    else
        sendW(false)
        if wLockout <= 0 and pitch < safeNum(AW.TARGET, 32) and speed < safeNum(AW.RISE_SPD, 4) then
            local err  = safeNum(AW.TARGET, 32) - pitch
            local fall = math.max(0, -speed)
            local duty = math.clamp(err/20 + fall/30, 0, 1)
            wTimer = safeNum(AW.PULSE_MIN, 0.06)
                + (safeNum(AW.PULSE_MAX, 0.2) - safeNum(AW.PULSE_MIN, 0.06)) * duty
            wLockout = 0.25
        end
    end
end)

